{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nonprophet.app/schemas/claims.schema.json",
  "title": "Normalized Non-Prophet seed claims",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_from", "entry_count", "entries"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_from": {"type": "string", "minLength": 1},
    "entry_count": {"const": 351},
    "entries": {
      "type": "array",
      "minItems": 351,
      "maxItems": 351,
      "items": {"$ref": "#/$defs/claim"}
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_id",
        "seed_claim",
        "review_status",
        "ot_passage",
        "ot_text",
        "nt_passages",
        "nt_texts"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^prophecy-[0-9]{3}$"},
        "source_id": {"type": "integer", "minimum": 1, "maximum": 351},
        "seed_claim": {"type": "string", "minLength": 1},
        "review_status": {"const": "unreviewed"},
        "ot_passage": {
          "allOf": [
            {"$ref": "https://nonprophet.app/schemas/reference.schema.json"},
            {"type": "object", "properties": {"testament": {"const": "OT"}}}
          ]
        },
        "ot_text": {"$ref": "#/$defs/scripture_text"},
        "nt_passages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "allOf": [
              {"$ref": "https://nonprophet.app/schemas/reference.schema.json"},
              {"type": "object", "properties": {"testament": {"const": "NT"}}}
            ]
          }
        },
        "nt_texts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/scripture_text"}
        }
      }
    },
    "scripture_text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["translation", "release", "selection", "verses"],
      "properties": {
        "translation": {"const": "BSB"},
        "release": {"const": "v5.9"},
        "selection": {
          "enum": ["complete_reference", "full_verse_pending_segment_mapping"]
        },
        "verses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["osis", "number", "text", "notes"],
            "properties": {
              "osis": {"type": "string", "pattern": "^[1-3]?[A-Za-z]+\\.[0-9]+\\.[0-9]+$"},
              "number": {"type": "integer", "minimum": 1},
              "text": {"type": "string", "minLength": 1},
              "notes": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    }
  }
}
